# --- Database (Neon Postgres via Vercel Marketplace) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Auth.js (Google sign-in) ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
AUTH_GOOGLE_ID="xxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxxxx"
# Allowed Google account(s). One email, or a comma-separated list for a team.
OWNER_EMAIL="you@gmail.com"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxx"
# Verified sender address on your Resend domain.
EMAIL_FROM="billing@yourfirm.co.il"

# Canonical prod URL, used for links inside emails.
APP_BASE_URL="https://your-lawfirm.vercel.app"

# --- Cron (monthly report auto-send) ---
# Random secret; Vercel Cron sends it as the request's bearer token.
CRON_SECRET="generate-a-long-random-string"
